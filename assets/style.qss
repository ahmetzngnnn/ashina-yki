/*
  ASHİNA YKİ — Modern Aviyonik GCS Teması
  ─────────────────────────────────────────
  Zemin   : #0d1318 (derin slate)   Panel: #151d25 / #1b242d
  Kenar   : #29333d / #35424d
  Metin   : #e4ebf1 / #8996a3 (muted)
  Accent  : #2dd4bf (teal — telemetri)   Info: #4aa3e0
  Semantik: success #40c463  warning #e0a83e  danger #ef5a55
*/

* {
    font-family: "Segoe UI", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 12px;
}

QWidget {
    background-color: #0d1318;
    color: #e4ebf1;
    selection-background-color: #2dd4bf;
    selection-color: #06231f;
}
QMainWindow, QDialog { background-color: #0d1318; }

/* ── Paneller / Kapsayıcılar ── */
QGroupBox {
    background-color: #151d25;
    border: 1px solid #29333d;
    border-radius: 8px;
    margin-top: 20px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 2px;
    padding: 2px 8px;
    color: #2dd4bf;
    font-size: 11px;
    letter-spacing: 1px;
    background: transparent;
}
QFrame { border-radius: 8px; }
QScrollArea { border: none; background: transparent; }

/* ── Butonlar ── */
QPushButton {
    background-color: #1f2a33;
    color: #e4ebf1;
    border: 1px solid #35424d;
    border-radius: 6px;
    padding: 7px 14px;
    font-weight: 600;
}
QPushButton:hover   { background-color: #27343e; border-color: #46545f; }
QPushButton:pressed { background-color: #18222a; }
QPushButton:disabled{ background-color: #141b21; color: #55626d; border-color: #232c34; }
QPushButton:focus   { outline: none; border-color: #2dd4bf; }

/* Semantik buton class'ları (objectName) */
QPushButton#primaryButton {
    background-color: #2dd4bf; color: #06231f; border: 1px solid #2dd4bf; font-weight: 700;
}
QPushButton#primaryButton:hover  { background-color: #45e0cf; }
QPushButton#primaryButton:pressed{ background-color: #23b3a1; }

QPushButton#successButton {
    background-color: #1c3a2a; color: #6ee7a0; border: 1px solid #2f6b48;
}
QPushButton#successButton:hover  { background-color: #244d38; border-color: #3f8a5d; }

QPushButton#dangerButton {
    background-color: #3a1f22; color: #ff8a85; border: 1px solid #7a3b3b;
}
QPushButton#dangerButton:hover   { background-color: #4d2629; border-color: #9a4747; }

QPushButton#warningButton {
    background-color: #3a2f18; color: #f0c060; border: 1px solid #7a6330;
}

/* ── Girdiler ── */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit {
    background-color: #0f161c;
    color: #e4ebf1;
    border: 1px solid #29333d;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 22px;
    selection-background-color: #2dd4bf;
    selection-color: #06231f;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #2dd4bf;
    background-color: #111a21;
}
QLineEdit:disabled, QComboBox:disabled { color: #55626d; background-color: #0c1116; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8996a3;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #151d25;
    border: 1px solid #35424d;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #1f2a33;
    selection-color: #2dd4bf;
    outline: none;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 16px; border: none; background: #1b242d; }

/* ── Sekmeler ── */
QTabWidget::pane {
    border: 1px solid #29333d;
    background-color: #0d1318;
    border-radius: 8px;
    top: -1px;
}
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    background: transparent;
    color: #8996a3;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 18px;
    margin-right: 2px;
    font-weight: 600;
}
QTabBar::tab:selected {
    color: #2dd4bf;
    border-bottom: 2px solid #2dd4bf;
}
QTabBar::tab:hover:!selected { color: #e4ebf1; }

/* ── Tablolar / Listeler ── */
QTableWidget, QTableView, QListWidget, QTreeWidget {
    background-color: #0f161c;
    alternate-background-color: #121a21;
    border: 1px solid #29333d;
    border-radius: 8px;
    gridline-color: #1f2932;
    selection-background-color: #1f2a33;
    selection-color: #2dd4bf;
    outline: none;
}
QHeaderView::section {
    background-color: #151d25;
    color: #8996a3;
    border: none;
    border-bottom: 1px solid #29333d;
    padding: 7px 10px;
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 1px;
}
QTableWidget::item { padding: 4px 6px; }

/* ── Metin kutuları ── */
QTextEdit {
    background-color: #0f161c;
    border: 1px solid #29333d;
    border-radius: 8px;
    padding: 4px;
}

/* ── CheckBox / RadioButton ── */
QCheckBox, QRadioButton { spacing: 8px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }
QCheckBox::indicator {
    border: 1px solid #46545f; border-radius: 4px; background: #0f161c;
}
QCheckBox::indicator:checked {
    background: #2dd4bf; border-color: #2dd4bf;
}
QRadioButton::indicator {
    border: 1px solid #46545f; border-radius: 8px; background: #0f161c;
}
QRadioButton::indicator:checked {
    background: #2dd4bf; border: 4px solid #0f161c;
}

/* ── Slider ── */
QSlider::groove:horizontal { height: 4px; background: #29333d; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #2dd4bf; border-radius: 2px; }
QSlider::handle:horizontal {
    width: 16px; height: 16px; margin: -7px 0; border-radius: 8px;
    background: #e4ebf1; border: 2px solid #2dd4bf;
}
QSlider::handle:horizontal:hover { background: #2dd4bf; }

/* ── Scrollbar ── */
QScrollBar:vertical   { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:vertical   { background: #35424d; min-height: 24px; border-radius: 5px; }
QScrollBar::handle:horizontal { background: #35424d; min-width: 24px; border-radius: 5px; }
QScrollBar::handle:hover { background: #46545f; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ── Progress Bar ── */
QProgressBar {
    background-color: #0f161c;
    border: 1px solid #29333d;
    border-radius: 6px;
    text-align: center;
    color: #e4ebf1;
    font-weight: 600;
    min-height: 16px;
}
QProgressBar::chunk {
    background-color: #2dd4bf;
    border-radius: 5px;
}

/* ── Status Bar ── */
QStatusBar {
    background-color: #0a0f13;
    border-top: 1px solid #29333d;
    color: #8996a3;
}
QStatusBar::item { border: none; }

/* ── ToolTip ── */
QToolTip {
    background-color: #1b242d;
    color: #e4ebf1;
    border: 1px solid #35424d;
    border-radius: 6px;
    padding: 6px 9px;
}

/* ── Menü ── */
QMenu {
    background-color: #151d25; border: 1px solid #35424d; border-radius: 8px; padding: 6px;
}
QMenu::item { padding: 7px 22px; border-radius: 4px; }
QMenu::item:selected { background-color: #1f2a33; color: #2dd4bf; }

/* ── Splitter ── */
QSplitter::handle { background: #1b242d; }
QSplitter::handle:hover { background: #2dd4bf; }
